# Copy to .env.local and fill in real values (never commit .env.local)

# Gemini API — AI Flight Director (§5a) + Mission Camera image models (§5b)
VITE_GEMINI_API_KEY=your-gemini-api-key
# Optional comma-separated backup keys, rotated on 429/quota errors
VITE_GEMINI_API_KEY_POOL=key-2,key-3

# Google Photorealistic 3D Tiles terrain for the launch site scenes (§5b/§14)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key